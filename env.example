MEALIE_URL=https://mealie.lab.kontoulis.cloud
MEALIE_TOKEN=your_mealie_api_token
CRON_SCHEDULE=0 18 * * 0

# Required. Use a bot dedicated to this script -- Telegram allows only one
# getUpdates poller per bot token, so sharing one with e.g. Home Assistant's
# telegram_bot integration will make both flaky.
TELEGRAM_BOT_TOKEN=your_botfather_token
# Your numeric Telegram user id: the only user whose commands are accepted,
# and the default notification recipient when TELEGRAM_NOTIFY_CHAT_IDS is empty.
TELEGRAM_ALLOWED_USER_ID=your_numeric_telegram_user_id
# Optional, comma-separated chat/user ids to notify on each generated plan
# and shopping list (e.g. "111111,222222"). Defaults to just the id above.
TELEGRAM_NOTIFY_CHAT_IDS=
